# Copy to .env and edit. Compose reads this file automatically.
#   cp .env.example .env

# ---------------------------------------------------------------------------
# Mode
# ---------------------------------------------------------------------------
#   open                     = published directly, anyone who reaches the port
#                              gets in
#   auth,p-<slug>,p-<slug>   = no direct port; one oauth2-proxy per provider,
#                              each with its own port and whitelists
#
# Example with two providers:  COMPOSE_PROFILES=auth,p-mbits,p-kunde-a
COMPOSE_PROFILES=open

# ---------------------------------------------------------------------------
# Networking
# ---------------------------------------------------------------------------
# Host port for `open` mode. In auth mode each provider has its own port below.
MMO_PORT=6080
# Host interface to bind. 127.0.0.1 keeps it local-only; use 0.0.0.0 to expose
# it on the LAN — only sensible behind auth (and behind a TLS reverse proxy).
MMO_BIND=127.0.0.1

# ---------------------------------------------------------------------------
# Storage
# ---------------------------------------------------------------------------
# Host directory mounted at /data, used ONLY by the path-based tools (Dir
# Compare, Dedup, Date Sorter). The upload-based tools (PDF merge/split/duplex,
# Image Shrinker) never touch it. Leaving it as the empty ./data directory
# effectively disables the path-based tools — point it at real data to enable
# them, and read the security note in the README first.
MMO_DATA_DIR=./data
# Must own/be writable by this uid:gid (the container drops to it).
APP_UID=1000
APP_GID=1000
TZ=Europe/Berlin

# Which file the allowlist generator reads to discover providers. Only change
# this if you renamed .env (e.g. for a second deployment on the same host).
#MMO_ENV_FILE=.env

# ---------------------------------------------------------------------------
# OIDC providers — one block per provider, ignored unless its profile is active
# ---------------------------------------------------------------------------
# Whitelists: ALLOWED_DOMAINS and ALLOWED_EMAILS are combined with OR — a user
# is admitted if their domain matches OR their address is listed. At least one
# of the two must be set per provider, otherwise the stack refuses to start.
# "*" is rejected in ALLOWED_DOMAINS: it would admit every account at that
# provider and make the user list meaningless.
#
# Every provider needs a *confidential* client (ID + secret) with the `email`
# scope; without an email claim neither whitelist can match. Register
# REDIRECT_URL verbatim at the provider — the /oauth2/callback path is fixed.
#
# Cookie secret per provider:  openssl rand -base64 32

# --- Provider 1: own IdP, whole domain allowed ------------------------------
OIDC_MBITS_ISSUER_URL=https://kc.mbits.info/realms/intern
OIDC_MBITS_CLIENT_ID=
OIDC_MBITS_CLIENT_SECRET=
OIDC_MBITS_REDIRECT_URL=https://files.mbits.info/oauth2/callback
OIDC_MBITS_ALLOWED_DOMAINS=mbits.info
OIDC_MBITS_ALLOWED_EMAILS=
OIDC_MBITS_COOKIE_SECRET=
OIDC_MBITS_PORT=6080

# --- Provider 2: customer IdP, only these named users -----------------------
OIDC_KUNDE_A_ISSUER_URL=
OIDC_KUNDE_A_CLIENT_ID=
OIDC_KUNDE_A_CLIENT_SECRET=
OIDC_KUNDE_A_REDIRECT_URL=https://files-kunde-a.mbits.info/oauth2/callback
OIDC_KUNDE_A_ALLOWED_DOMAINS=
OIDC_KUNDE_A_ALLOWED_EMAILS=chef@kunde-a.de, azubi@kunde-a.de
OIDC_KUNDE_A_COOKIE_SECRET=
OIDC_KUNDE_A_PORT=6081

# --- Provider 3: domain plus two external individuals -----------------------
OIDC_KUNDE_B_ISSUER_URL=
OIDC_KUNDE_B_CLIENT_ID=
OIDC_KUNDE_B_CLIENT_SECRET=
OIDC_KUNDE_B_REDIRECT_URL=https://files-kunde-b.mbits.info/oauth2/callback
OIDC_KUNDE_B_ALLOWED_DOMAINS=kunde-b.de
OIDC_KUNDE_B_ALLOWED_EMAILS=extern@partner.de
OIDC_KUNDE_B_COOKIE_SECRET=
OIDC_KUNDE_B_PORT=6082

# ---------------------------------------------------------------------------
# Shared cookie/session settings (all providers)
# ---------------------------------------------------------------------------
# true only when the app is reached over https:// — required in production.
OIDC_COOKIE_SECURE=false
OIDC_COOKIE_EXPIRE=168h
